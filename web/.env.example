# Base URL of the Function API (GET /api/negotiate, GET /api/cards). Leave unset for the demo-only console.
# GitHub Pages build (ADR-043): the Function App directly, https://<function-app-host>/api, set as the
# repository variable VITE_API_BASE_URL. Its origin is added to the CSP; the Function App's CORS allows Pages.
# Live mode then opens with ?match=<match_id>, e.g. /calacat-narrator/?match=m-seed-7
VITE_API_BASE_URL=

# Local dev against Azure: set VITE_API_BASE_URL=/api and point the dev server's /api proxy at the
# Function App (no CORS needed). Dev server only; not used by `npm run build`.
API_PROXY_TARGET=

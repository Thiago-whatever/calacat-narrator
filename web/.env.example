# Base URL of the Function API (GET /api/negotiate, GET /api/cards). Leave unset for the demo-only console.
# On Static Web Apps with the linked Function App backend (ADR-036) use the same-origin path: /api
# Before linking, the Function App directly: https://<function-app-host>/api (needs CORS, and a CSP edit).
# Live mode then opens with ?match=<match_id>, e.g. /?match=m-0007
VITE_API_BASE_URL=
